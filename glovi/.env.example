# Node 24. Ejecutar: node --env-file=.env --import tsx server/index.ts
PORT=3200
HOST=127.0.0.1
DATABASE_PATH=data/glovi.sqlite
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Sin clave/modelo: guía local, claramente identificada; no simula IA.
GEMINI_API_KEY=
GEMINI_MODEL=
# HTTPS lo termina el proxy en producción. Activa cookies Secure tras configurarlo.
COOKIE_SECURE=false
PUBLIC_ORIGIN=
# Orígenes que pueden insertar el widget, separados por espacios.
EMBED_ORIGINS=
