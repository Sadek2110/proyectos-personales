---
/**
 * Luces difusas del hero. Tres orbes con la paleta de acento, muy desenfocados
 * y a baja opacidad: dan profundidad sin caer en "neon overload"
 * (docs/brief-maestro.md §9 y §10).
 *
 * El paralaje lo aplica el script global de Base.astro sobre --pointer-x/y;
 * sin JS o con reduced-motion, los orbes quedan estáticos.
 */
---

<div class="hero-glow" data-hero-glow aria-hidden="true">
  <span class="hero-orb hero-orb--accent"></span>
  <span class="hero-orb hero-orb--violet"></span>
  <span class="hero-orb hero-orb--cyan"></span>
</div>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
    /* Desplazamiento del puntero, en px. Lo escribe el script global. */
    --pointer-x: 0;
    --pointer-y: 0;
  }

  .hero-orb {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(90px);
    will-change: transform;
  }

  .hero-orb--accent {
    inline-size: 38vw;
    block-size: 38vw;
    min-inline-size: 20rem;
    min-block-size: 20rem;
    top: -8%;
    left: -6%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 30%, transparent), transparent 68%);
    animation: hero-orb-a 26s ease-in-out infinite alternate;
    translate: calc(var(--pointer-x) * 1px) calc(var(--pointer-y) * 1px);
  }

  .hero-orb--violet {
    inline-size: 34vw;
    block-size: 34vw;
    min-inline-size: 18rem;
    min-block-size: 18rem;
    bottom: -14%;
    left: 18%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent-violet) 34%, transparent), transparent 68%);
    animation: hero-orb-b 32s ease-in-out infinite alternate;
    translate: calc(var(--pointer-x) * -0.6px) calc(var(--pointer-y) * -0.6px);
  }

  .hero-orb--cyan {
    inline-size: 26vw;
    block-size: 26vw;
    min-inline-size: 14rem;
    min-block-size: 14rem;
    top: 22%;
    right: 6%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent-cyan) 26%, transparent), transparent 68%);
    animation: hero-orb-c 24s ease-in-out infinite alternate;
    translate: calc(var(--pointer-x) * 0.45px) calc(var(--pointer-y) * 0.45px);
  }

  /* La deriva es lenta y de pocos px: acompaña, no llama la atención. */

  @keyframes hero-orb-a {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.55;
    }
    to {
      transform: translate3d(3%, 4%, 0) scale(1.08);
      opacity: 0.75;
    }
  }

  @keyframes hero-orb-b {
    from {
      transform: translate3d(0, 0, 0) scale(1.05);
      opacity: 0.45;
    }
    to {
      transform: translate3d(-4%, -3%, 0) scale(1);
      opacity: 0.65;
    }
  }

  @keyframes hero-orb-c {
    from {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.4;
    }
    to {
      transform: translate3d(-3%, 5%, 0) scale(1.1);
      opacity: 0.6;
    }
  }

  /* En pantallas pequeñas el hero es más estrecho: menos difusión, menos GPU. */

  @media (max-width: 640px) {
    .hero-orb {
      filter: blur(64px);
    }

    .hero-orb--cyan {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb {
      animation: none;
      translate: none;
      opacity: 0.5;
    }
  }
</style>
