---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm";
---

<BaseLayout
  title="Start a project — Aurora Studios"
  description="Tell Aurora Studios about your next brand, website or digital product."
>
  <main class="mx-auto grid min-h-svh max-w-[1600px] gap-16 px-6 pt-32 pb-24 md:px-10 lg:grid-cols-12 lg:px-16 lg:pt-40">
    <div class="lg:col-span-5">
      <p class="font-mono text-[11px] tracking-[0.24em] text-muted uppercase">
        New business
      </p>
      <h1 class="mt-6 font-display text-5xl leading-[0.95] tracking-tight md:text-7xl">
        Start a
        <br />
        project.
      </h1>
      <p class="mt-8 max-w-sm text-sm leading-relaxed text-muted">
        Share a few details. We'll come back with questions, a point of view, and
        whether we're the right studio for it.
      </p>
      <a
        href="mailto:hello@aurora.studio"
        data-cursor="hover"
        class="mt-10 inline-block text-sm"
      >
        hello@aurora.studio
      </a>
    </div>
    <div class="lg:col-span-7">
      <ContactForm client:load />
    </div>
  </main>
</BaseLayout>
