{
  "name": "life-os",
  "version": "1.0.0",
  "private": true,
  "description": "Centro de mando personal con agente: compras, tareas, rutas, horario y clase sobre Google Sheets, Tasks y Calendar",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "demo:api": "node -e \"process.env.DEMO='true';process.env.COOKIE_SECURE='false';process.env.APP_PASSWORD=process.env.APP_PASSWORD||'demo';process.env.SESSION_SECRET=process.env.SESSION_SECRET||'x'.repeat(32);require('./server.js')\"",
    "demo": "vite build && npm run demo:api",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tanstack/query-sync-storage-persister": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "^5.105.3",
    "@vitejs/plugin-react": "^6.2.1",
    "leaflet": "^1.9.4",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
