# Base de datos PostgreSQL (en Easypanel: la "Internal Connection URL" del servicio de Postgres)
DATABASE_URL=postgres://usuario:clave@aula-db:5432/aula

# Secreto para firmar las sesiones. Pon una cadena larga y aleatoria.
JWT_SECRET=

# URL pública de la app (para los enlaces de invitación y los que se mandan a n8n)
APP_URL=https://aula.tudominio.es

# Administrador inicial. Se crea en el primer arranque si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Sadek

# n8n: webhook que recibe todos los eventos y secreto que se envía en la cabecera X-Webhook-Secret
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Clave con la que n8n llama a /api/integraciones (cabecera X-API-Key)
INTEGRACIONES_API_KEY=

# Opcional: envío directo de invitaciones por SMTP (Gmail con contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Minutos de cortesía antes de marcar Retraso al fichar
TOLERANCIA_RETRASO_MIN=10
