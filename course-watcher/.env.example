# Credenciales Moodle Centros (Junta de Andalucía — SSO CAS)
MOODLE_USER=
MOODLE_PASS=
# Opcional: si ya se obtuvo el wstoken, se reutiliza desde /data/watcher-estado.json o desde aquí
MOODLE_TOKEN=

# Credenciales Curso 2 — Especialización en Ciberseguridad
CIBER_URL=
CIBER_USER=
CIBER_PASS=

# Google Classroom (Puente Apps Script en cuenta @g.educaand.es o Plan B correo)
CLASSROOM_GAS_URL=
CLASSROOM_GAS_TOKEN=

# Destino en Life OS
LIFEOS_URL=https://lifeos.dksaa.com
INGESTA_TOKEN=

# Opcional: Gemini para resúmenes de temas o extracción en Plan B (Playwright)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_RESERVA=gemini-3.5-flash-lite

# Configuración del servicio
DATA_DIR=.data
CRON_HORARIO=08:00-22:00
CRON_INTERVALO_MIN=120
MODO_SIMULACRO=false
